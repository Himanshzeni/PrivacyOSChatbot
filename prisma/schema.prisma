generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 1. Structured Company Knowledge (Facts, Services, FAQs)
model CompanyKnowledge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  category    String   // "SERVICE" | "COMPANY_FACT" | "FAQ" | "CONTACT_INFO"
  key         String   @unique
  title       String
  content     String
  metadata    Json?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// 2. Vector Knowledge Chunks (Hybrid RAG: Website + DPDP Act)
model KnowledgeChunk {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  category        String   // "WEBSITE_CONTENT" | "DPDP_LEGAL"
  sourceUrl       String?
  sourceCitation  String   // e.g., "Source: DPDP Act 2023, Section 6(1)" or "Source: Website Services Page"
  title           String
  content         String
  embedding       Float[]  // 768-dim (Gemini text-embedding-004) or Atlas Vector Search
  metadata        Json?
  contentHash     String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// 3. Crawler Staging Queue (Review & Approval Gate)
model CrawlStaging {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  url           String   @unique
  title         String
  extractedText String
  contentHash   String
  status        String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy    String?
  reviewedAt    DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// 4. Temporary Bot Enquiry (EPHEMERAL - Subject to PII Purge upon Form Submission)
model TemporaryBotEnquiry {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId   String    @unique
  sessionId        String
  detectedName     String?
  detectedEmail    String?
  detectedPhone    String?
  requirementNotes String?
  intentScore      Float?
  isPurged         Boolean   @default(false)
  purgedAt         DateTime?
  expiresAt        DateTime  // Auto-expiry TTL
  createdAt        DateTime  @default(now())
}

// 5. Official Website Submitted Enquiry (Permanent Single Source of Truth)
model SubmittedEnquiry {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String?  // Carried from chatbot session
  name           String
  email          String
  phone          String
  websiteUrl     String?
  service        String
  notes          String?
  status         String   @default("NEW") // "NEW" | "CONTACTED" | "QUALIFIED" | "CLOSED"
  createdAt      DateTime @default(now())
}

// 6. Privacy-Sanitized Funnel Analytics (Zero Raw PII)
model AnalyticsEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType      String   // "chat_opened" | "message_sent" | "intent_detected" | "cta_clicked" | "form_reached" | "form_submitted"
  conversationId String?
  sessionId      String?
  pagePath       String?
  intentType     String?  // "CASUAL" | "INFORMATIONAL" | "STRONG_ENQUIRY"
  tokensUsed     Int?
  latencyMs      Int?
  metadata       Json?
  createdAt      DateTime @default(now())
}

// 7. Admin RBAC User
model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // "ADMIN" | "MANAGER" | "TECHNICAL"
  createdAt    DateTime @default(now())
}
